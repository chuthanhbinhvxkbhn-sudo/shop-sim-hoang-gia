
let category="",sims=[];
const $=id=>document.getElementById(id),money=n=>Number(n).toLocaleString("vi-VN")+" đ";
async function loadSims(){
 const p=new URLSearchParams();if($("q").value)p.set("q",$("q").value);if($("network").value)p.set("network",$("network").value);if($("max").value)p.set("max",$("max").value);if(category)p.set("category",category);p.set("sort",$("sort").value);
 const r=await fetch("/api/sims?"+p);const data=await r.json();if(!r.ok){toast(data.error||"Không tải được kho");return}sims=data;$("info").textContent=`Có ${data.length} SIM phù hợp`;$("grid").innerHTML=data.map(s=>`<div class="card"><span class="tag">${s.type}</span><div class="num">${s.number}</div><small>${s.network} • ✓ Còn hàng</small><div class="price">${money(s.price)}</div><div class="cardActions"><button onclick="order('${s.id}')">Mua / Tư vấn</button><button class="outline" onclick="order('${s.id}')">Chọn số</button></div></div>`).join("")||"<p>Không có SIM phù hợp.</p>";
}
function order(id){const s=sims.find(x=>String(x.id)===String(id));$("modalBody").innerHTML=`<h2>Đăng ký mua / tư vấn</h2><div class="notice"><b>${s.number}</b> • ${s.network} • ${money(s.price)}</div><div class="form"><input id="name" placeholder="Họ và tên *"><input id="phone" placeholder="Số điện thoại *"><textarea id="note" placeholder="Nhu cầu / ghi chú"></textarea><button onclick="submitOrder('${s.id}')">Gửi yêu cầu cho SHOP</button></div>`;$("modal").classList.add("show")}
async function submitOrder(id){const name=$("name").value.trim(),phone=$("phone").value.trim(),note=$("note").value.trim();if(!name||!phone)return toast("Vui lòng nhập họ tên và số điện thoại");const r=await fetch("/api/orders",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({simId:id,name,phone,note})});const d=await r.json();if(!r.ok)return toast(d.error||"Không gửi được");closeModal();toast("Đã gửi yêu cầu. SHOP sẽ liên hệ tư vấn.");loadSims()}
function aiAsk(){const t=$("aiInput").value.trim();if(!t)return;add(t,"user");let low=t.toLowerCase();let net=["viettel","vinaphone","mobifone","vietnamobile"].find(x=>low.includes(x));let max="";const m=low.match(/(\d+(?:[.,]\d+)?)\s*(triệu|tr|k|nghìn|ngàn)/);if(m)max=Math.round(parseFloat(m[1].replace(",","."))*(m[2].startsWith("tri")||m[2]==="tr"?1e6:1e3));let c=low.includes("ngũ quý")?"ngu-quy":low.includes("tứ quý")?"tu-quy":low.includes("tam hoa")?"tam-hoa":low.includes("số tiến")||low.includes("số tiến")?"so-tien":low.includes("dễ nhớ")?"de-nho":"";let p=new URLSearchParams();if(net)p.set("network",net==="vinaphone"?"VinaPhone":net[0].toUpperCase()+net.slice(1));if(max)p.set("max",max);if(c)p.set("category",c);fetch("/api/sims?"+p).then(r=>r.json()).then(a=>{a=a.slice(0,5);add(a.length?`Tôi tìm được <b>${a.length} SIM</b>:<br>`+a.map(s=>`<div class="notice"><b>${s.number}</b> — ${money(s.price)}<br><button onclick="order('${s.id}')">Tư vấn số này</button></div>`).join(""):"Kho chưa có số đúng tiêu chí.","bot")});$("aiInput").value=""}
function add(x,c){const d=document.createElement("div");d.className="msg "+c;d.innerHTML=x;$("chat").appendChild(d);$("chat").scrollTop=99999}
function closeModal(){$("modal").classList.remove("show")}function toast(x){$("toast").textContent=x;$("toast").style.display="block";setTimeout(()=>$("toast").style.display="none",2300)}
function resetFilters(){category="";$("q").value="";$("network").value="";$("max").value="";loadSims()}
document.addEventListener("click",e=>{let b=e.target.closest("[data-cat]");if(b){category=b.dataset.cat;loadSims()}let p=e.target.closest("[data-p]");if(p){$("aiInput").value=p.dataset.p;aiAsk()}});$("modal").onclick=e=>{if(e.target.id==="modal")closeModal()};loadSims();
