
let token="",sims=[],orders=[];
const $=id=>document.getElementById(id),money=n=>Number(n).toLocaleString("vi-VN")+" đ";
async function api(url,opt={}){opt.headers={...(opt.headers||{}),Authorization:"Basic "+token};const r=await fetch(url,opt);const d=await r.json();if(r.status===401){logout();throw Error(d.error||"Sai đăng nhập")}if(!r.ok)throw Error(d.error||"Lỗi");return d}
async function login(){const u=$("user").value,p=$("pass").value;if(!u||!p)return;token=btoa(u+":"+p);try{await api("/api/admin/stats");$("login").style.display="none";$("panel").style.display="block";load()}catch(e){token="";alert(e.message)}}
async function load(){const [st,ss,oo]=await Promise.all([api("/api/admin/stats"),api("/api/admin/sims"),api("/api/admin/orders")]);sims=ss;orders=oo;$("a").textContent=st.available;$("r").textContent=st.reserved;$("s").textContent=st.sold;$("o").textContent=st.new_orders;renderInv();renderOrders()}
function renderInv(){const q=($("find").value||"").replaceAll(".","").toLowerCase();$("invTable").innerHTML=sims.filter(s=>s.number.replaceAll(".","").toLowerCase().includes(q)).map(s=>`<tr><td>${s.id}</td><td><b>${s.number}</b></td><td>${s.network}</td><td>${s.type}</td><td>${money(s.price)}</td><td>${s.status}</td><td><button onclick="editSim(${s.id})">Sửa</button> <button onclick="toggle(${s.id},'${s.status}')">${s.status==="sold"?"Mở bán":"Đã bán"}</button></td></tr>`).join("")}
function renderOrders(){$("ordTable").innerHTML=orders.map(o=>`<tr><td>${new Date(o.created_at).toLocaleString("vi-VN")}</td><td>${o.number}</td><td>${o.customer_name}</td><td>${o.phone}</td><td>${o.note||""}</td><td><select onchange="status(${o.id},this.value)"><option ${o.status==="Mới"?"selected":""}>Mới</option><option ${o.status==="Đang tư vấn"?"selected":""}>Đang tư vấn</option><option ${o.status==="Đã chốt"?"selected":""}>Đã chốt</option><option ${o.status==="Đã hủy"?"selected":""}>Đã hủy</option></select></td><td><a href="tel:${o.phone}">Gọi</a></td></tr>`).join("")}
async function addSim(){open(`<h2>Thêm SIM</h2><div class="form"><input id="n" placeholder="Số SIM *"><select id="net"><option>Viettel</option><option>VinaPhone</option><option>MobiFone</option><option>Vietnamobile</option></select><input id="type" placeholder="Dạng số"><input id="cat" placeholder="Danh mục, ví dụ tam-hoa"><input id="price" type="number" placeholder="Giá VNĐ *"><button onclick="saveNew()">Thêm</button></div>`)}
async function saveNew(){try{await api("/api/admin/sims",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({number:$("n").value,network:$("net").value,type:$("type").value,category:$("cat").value,price:+$("price").value})});close();load()}catch(e){alert(e.message)}}
function editSim(id){const s=sims.find(x=>x.id==id);open(`<h2>Sửa SIM</h2><div class="form"><input id="en" value="${s.number}"><select id="enet"><option ${s.network==="Viettel"?"selected":""}>Viettel</option><option ${s.network==="VinaPhone"?"selected":""}>VinaPhone</option><option ${s.network==="MobiFone"?"selected":""}>MobiFone</option><option ${s.network==="Vietnamobile"?"selected":""}>Vietnamobile</option></select><input id="et" value="${s.type}"><input id="ec" value="${s.category}"><input id="ep" type="number" value="${s.price}"><select id="es"><option ${s.status==="available"?"selected":""}>available</option><option ${s.status==="reserved"?"selected":""}>reserved</option><option ${s.status==="sold"?"selected":""}>sold</option></select><button onclick="saveEdit(${id})">Lưu</button></div>`)}
async function saveEdit(id){const s=sims.find(x=>x.id==id);try{await api("/api/admin/sims/"+id,{method:"PUT",headers:{"Content-Type":"application/json"},body:JSON.stringify({number:$("en").value,network:$("enet").value,type:$("et").value,category:$("ec").value,price:+$("ep").value,status:$("es").value})});close();load()}catch(e){alert(e.message)}}
async function toggle(id,status){try{await api("/api/admin/sims/"+id,{method:"PUT",headers:{"Content-Type":"application/json"},body:JSON.stringify({...sims.find(x=>x.id==id),status:status==="sold"?"available":"sold"})});load()}catch(e){alert(e.message)}}
async function status(id,x){try{await api("/api/admin/orders/"+id,{method:"PUT",headers:{"Content-Type":"application/json"},body:JSON.stringify({status:x})});load()}catch(e){alert(e.message)}}
function open(x){$("body").innerHTML=x;$("modal").classList.add("show")}function close(){$("modal").classList.remove("show")}function logout(){token="";$("panel").style.display="none";$("login").style.display="grid"}function exportCSV(){const rows=[["id","number","network","type","category","price","status"],...sims.map(s=>[s.id,s.number,s.network,s.type,s.category,s.price,s.status])];const a=document.createElement("a");a.href=URL.createObjectURL(new Blob(["\ufeff"+rows.map(x=>x.join(",")).join("\n")],{type:"text/csv"}));a.download="kho-sim.csv";a.click()}function importCSV(){alert("Bản này ưu tiên nhập kho qua API. Nếu bạn có file Excel/CSV kho SIM, gửi file cho tôi để tôi chuẩn hóa thành dữ liệu import cho hệ thống.")}
document.querySelectorAll(".tabs button").forEach(b=>b.onclick=()=>{document.querySelectorAll(".tabs button").forEach(x=>x.classList.remove("active"));document.querySelectorAll(".tab").forEach(x=>x.classList.remove("active"));b.classList.add("active");$(b.dataset.tab).classList.add("active")});$("modal").onclick=e=>{if(e.target.id==="modal")close()};
